---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Roman Leonov | Senior Embedded Software Engineer"
  description="Roman Leonov is a Senior Embedded Software Engineer specializing in firmware architecture, USB, RTOS, and embedded systems."
>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Embedded Systems Engineer</p>

      <h1>Roman Leonov</h1>

      <div class="accent-line"></div>

      <p class="intro">
      	I'm an engineer at heart, not just by profession.
      </p>

      <p>
	I develop embedded systems and USB devices, contribute to open-source
	projects, and enjoy solving technical challenges.

	Outside of work, I love bringing broken electronics back to life,
	especially children's toys, mobile phones and tablets.
      </p>

      <div class="actions">
        <a
          href="https://github.com/roma-jam"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>

        <a
          href="https://www.linkedin.com/in/roman-leonov-007041a8/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn ↗
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <a
        class="profile-main-link"
        href="https://www.linkedin.com/in/roman-leonov-007041a8/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open LinkedIn profile"
      >
        <img
          class="profile-main"
          src="/icons/personal-profile.webp"
          alt="Portrait of Roman Leonov"
        />
      </a>

      <a
        class="profile-secondary-link"
        href="https://github.com/roma-jam"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open GitHub profile"
      >
        <img
          class="profile-secondary"
          src="/icons/github-avatar.webp"
          alt="GitHub profile avatar of Roman Leonov"
        />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: 3rem;
    align-items: center;
    padding-block: 3rem;
  }

  .hero-text {
    max-width: 680px;
  }

  .eyebrow {
    color: var(--color-purple);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    margin-block: 0.5rem 1.25rem;
  }

  .accent-line {
    width: 84px;
    height: 4px;
    border-radius: 999px;
    background: var(--gradient-accent);
    margin-bottom: 1.75rem;
  }

  .intro {
    font-size: 1.2rem;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .primary-button {
    display: inline-block;
    padding: 0.8rem 1.3rem;
    border-radius: 10px;
    background: var(--gradient-accent);
    color: white;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(66, 110, 192, 0.18);
  }

  .primary-button:hover {
    color: white;
    opacity: 0.94;
  }

  .hero-visual {
    position: relative;
    width: fit-content;
    margin-inline: auto;
    padding: 1rem;
  }

  .profile-main-link,
  .profile-secondary-link {
    display: inline-block;
  }

  .profile-main {
    width: 220px;
    height: 220px;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    border: 4px solid white;
    outline: 3px solid var(--color-purple);
    box-shadow: 0 16px 40px rgba(32, 47, 74, 0.16);
    background: #fff;
  }

  .profile-secondary-link {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
  }

  .profile-secondary {
    width: 86px;
    height: 86px;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    border: 4px solid var(--color-background);
    outline: 2px solid var(--color-blue);
    box-shadow: 0 10px 24px rgba(32, 47, 74, 0.18);
    background: #fff;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-text {
      order: 2;
    }

    .hero-visual {
      order: 1;
    }
  }

  @media (max-width: 480px) {
    .profile-main {
      width: 180px;
      height: 180px;
    }

    .profile-secondary {
      width: 72px;
      height: 72px;
    }
  }
</style>