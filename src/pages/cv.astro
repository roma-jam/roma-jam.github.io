
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content } from '../content/resume.md';
---

<BaseLayout
  title="CV | Roman Leonov — Senior Embedded Software Engineer"
  description="Professional experience, technical expertise, and open-source contributions of Roman Leonov, Senior Embedded Software Engineer."
>
  <div class="cv-page">
    <div class="cv-header">
      <span class="section-label">Professional Experience</span>

      <a
        class="download-button"
        href="/documents/Roman_Leonov_Senior_Embedded_Software_Engineer.pdf"
        download
      >
        ↓ Download [EN] 
      </a>
    </div>

    <article class="resume-content">
      <Content />
    </article>
  </div>
</BaseLayout>

<style>
  .cv-page {
    width: 100%;
    margin: 0 auto;
  }

  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section-label {
    color: var(--color-purple);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .github-link {
    font-size: 0.9rem;
  }

  .resume-content {
    font-size: 1rem;
    line-height: 1.8;
  }

  .resume-content :global(h1) {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .resume-content :global(h2) {
    font-size: 1.5rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .resume-content :global(h3) {
    font-size: 1.15rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .resume-content :global(p) {
    margin-block: 0.75rem 1.25rem;
  }

  .resume-content :global(ul) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .resume-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .resume-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .resume-content :global(strong) {
    color: var(--color-text);
  }

  .resume-content :global(em) {
    color: var(--color-muted);
  }

  @media (max-width: 600px) {
    .cv-header {
      align-items: flex-start;
    }

    .resume-content {
      font-size: 0.95rem;
    }
  }
</style>
